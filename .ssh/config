Include ~/.colima/ssh_config

Host *.azure.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/my-ado-id

Host *.github.com
  AddKeystoAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/my-gh-id

